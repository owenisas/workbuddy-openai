{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "workbuddy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WorkBuddy",
      "options": {
        "baseURL": "https://www.workbuddy.ai/v2",
        "apiKey": "{env:WORKBUDDY_ACCESS_TOKEN}"
      },
      "models": {
        "default-model": { "name": "Default" },
        "fast-model": { "name": "Fast" },
        "balanced-model": { "name": "Balanced" },
        "primary-model": { "name": "Primary" },
        "deep-model": { "name": "Deep" }
      }
    }
  }
}
